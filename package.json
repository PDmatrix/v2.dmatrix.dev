{
  "name": "dmatrix.dev",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.16.0 <25 || >=26.3.0"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build && pagefind --site dist && node scripts/copy-search.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "postinstall": "husky",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright install chromium",
    "validate": "yarn format:check && yarn lint && yarn build && yarn test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "dayjs": "^1.11.23",
    "github-slugger": "^2.0.0",
    "reading-time": "^1.5.0",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.34.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@pagefind/default-ui": "^1.5.2",
    "@playwright/test": "^1.64.0",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "resolutions": {
    "satori/fflate": "0.7.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,mdx,yml,yaml}": "prettier --write"
  }
}
